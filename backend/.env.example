# ========= APP ==========
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=logs

# ========= COSMOS DB ==========
COSMOSDB_URI=https://moncosmosfree.documents.azure.com:443/
COSMOS_DATABASE=your_database_name
COSMOSDB_CONTAINER_DOCUMENTS=documents
COSMOSDB_CONTAINER_CHUNKS=chunks
COSMOSDB_CONTAINER_WORK_ITEMS=work_items
COSMOSDB_CONTAINER_CONVERSATIONS=conversations
COSMOSDB_CONTAINER_MESSAGES=messages
CHAT_HISTORY_USER_ID=local-user

# Compat / legacy si encore utilisé dans certains modules
COSMOS_ENDPOINT=https://moncosmosfree.documents.azure.com:443/
COSMOS_CONTAINER_DOCUMENTS=documents
COSMOS_CONTAINER_CHUNKS=chunks

# ========= AZURE SEARCH ==========
AZURE_SEARCH_ENDPOINT=https://ragaisearch123.search.windows.net
AZURE_SEARCH_INDEX=your-index-name

# ========= AZURE OPENAI ==========
AZURE_OPENAI_ENDPOINT=https://openiarag123.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# ========= EMBEDDINGS ==========
EMBEDDING_DIM=1536

AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret